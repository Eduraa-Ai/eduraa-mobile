# Copy this file to .env. With every value left unset, development uses:
# - web: the browser hostname on port 8000
# - Android emulator: http://10.0.2.2:8000
# - iOS simulator: http://localhost:8000

# Set one URL to use a remote API or a physical-device LAN endpoint.
# EXPO_PUBLIC_API_URL=https://api.example.com

# Development-only platform overrides take precedence over EXPO_PUBLIC_API_URL.
# Preview and production builds reject these to keep one canonical API origin.
# EXPO_PUBLIC_WEB_API_URL=https://web-api.example.com
# EXPO_PUBLIC_NATIVE_API_URL=https://native-api.example.com

# Local start commands launch the browser CORS bridge automatically. Set its
# upstream here; Expo web is then pointed at localhost:8001.
# EDURAA_API_UPSTREAM_URL=https://api.example.com

# Do not rely on this file for EAS releases. Configure EXPO_PUBLIC_API_URL in
# the EAS preview and production environments. Release profiles accept only a
# public HTTPS origin with no credentials, path, query, or fragment.
