# Eduraa Mobile - Environment Variables
# Copy this to .env and choose the API target for the current run.

# local: Expo web resolves to the browser host on port 8000.
# prod: Uses the production API URL baked into src/api/client.ts.
EXPO_PUBLIC_API_TARGET=localhost:8000

# Optional final override.
# Use this for a physical device on the same network, for example:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
# Leave blank/commented for normal local web or prod target switching.
# EXPO_PUBLIC_API_URL=

# Do not combine EXPO_PUBLIC_API_TARGET=prod with a localhost override. EAS
# preview and production builds set the prod target explicitly in eas.json.

# Testing prod from Expo WEB in a browser: browsers enforce CORS and the prod
# API only allows its deployed origins, so direct calls from localhost fail
# with a network error. Run the local bridge (npm run api-bridge) and set:
# EXPO_PUBLIC_API_URL=http://localhost:8001
# Phones/emulators are not affected by CORS - plain target=prod works there.
