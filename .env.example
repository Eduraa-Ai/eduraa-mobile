# Eduraa Mobile - Environment Variables
# Copy this to .env and choose the API target for the current run.

# local: Expo web resolves to the browser host on port 8000.
# prod: Uses the production API URL baked into src/api/client.ts.
EXPO_PUBLIC_API_TARGET=localhost:8000

# Optional final override.
# Use this for a physical device on the same network, for example:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
# Leave blank/commented for normal local web or prod target switching.
# EXPO_PUBLIC_API_URL=
