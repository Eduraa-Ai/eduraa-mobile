{
  "name": "eduraa-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/start-web.cjs",
    "expo-go": "node scripts/start-web.cjs --go --tunnel --clear",
    "android": "node scripts/start-web.cjs --android",
    "ios": "node scripts/start-web.cjs --ios",
    "web": "node scripts/start-web.cjs --web",
    "web:remote": "node scripts/start-web.cjs --web",
    "attendance:preview": "node scripts/start-attendance-preview.cjs",
    "attendance:capture": "node scripts/capture-attendance.mjs",
    "api-bridge": "node scripts/dev-api-bridge.cjs",
    "check:deps": "expo install --check",
    "audit:critical": "node scripts/audit-critical.cjs",
    "test:audit": "node --test scripts/audit-critical.test.cjs",
    "validate:release-env": "node scripts/validate-release-env.cjs",
    "eas-build-post-install": "npm run validate:release-env",
    "typecheck": "tsc --noEmit",
    "test:config": "tsx --test scripts/api-config.test.ts",
    "test:auth-motion": "tsx --test scripts/auth-motion.test.ts",
    "test:ai-stream": "tsx --test scripts/ai-stream.test.ts",
    "test:release-env": "node --test scripts/release-env.test.cjs",
    "test:bridge": "node --test scripts/dev-api-bridge.test.cjs",
    "test:models": "node scripts/run-model-tests.cjs",
    "test": "npm run test:config && npm run test:auth-motion && npm run test:ai-stream && npm run test:release-env && npm run test:bridge && npm run test:audit && npm run test:models",
    "export:web": "node scripts/validate-release-env.cjs --release && expo export --platform web",
    "export:ci": "node scripts/validate-release-env.cjs --release && expo export --platform all"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "date-fns": "^3.6.0",
    "expo": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "ipaddr.js": "2.4.0",
    "punycode": "^2.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mathjax-html-to-svg": "^1.1.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
